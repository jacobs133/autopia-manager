{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Autopia Manager",
  "version": "0.1.0",
  "identifier": "it.autopiashop.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Autopia Manager - Gestionale Autodemolizioni",
        "width": 1320,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "it-IT"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Italian"]
      }
    }
  }
}
